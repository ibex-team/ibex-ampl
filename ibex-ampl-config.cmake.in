# CMake configuration file for IBEX_AMPL

include(CMakeFindDependencyMacro)

# ---------------------------------------------------------------------------
# Find IBEX dependency
# ---------------------------------------------------------------------------

# Help locate IBEX using the path recorded when IBEX_AMPL was built.
# Preserve any path explicitly provided by the user.
if(NOT DEFINED ENV{IBEX_DIR} AND NOT DEFINED IBEX_DIR)
    set(ENV{IBEX_DIR} "@IBEX_DIR@")
endif()

find_dependency(IBEX @IBEX_MIN_VERSION_REQ@)

# ---------------------------------------------------------------------------
# Find ASL dependency
# ---------------------------------------------------------------------------

# First, look for ASL installed as a bundled dependency of IBEX_AMPL.
# In that case, its configuration file is installed in:
#   <prefix>/share/ibex_ampl/cmake/3rd/ampl-asl/

find_package(ASL CONFIG QUIET
    NAMES ampl-asl
    PATHS "${CMAKE_CURRENT_LIST_DIR}/3rd/ampl-asl"
    NO_DEFAULT_PATH
)

# Otherwise, look for an independently installed ASL package.
if(NOT ASL_FOUND)
    find_dependency(ASL CONFIG NAMES ampl-asl)
endif()

# ---------------------------------------------------------------------------
# Load IBEX_AMPL exported targets
# ---------------------------------------------------------------------------

include("${CMAKE_CURRENT_LIST_DIR}/@IBEX_AMPL_TARGETS_CONFIG_FILE@")
